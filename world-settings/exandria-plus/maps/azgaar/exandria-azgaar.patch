+import { mkdirSync, readFileSync, writeFileSync, existsSync } from "node:fs";
 import { fileURLToPath, URL } from "node:url";
+import type { Connect, ViteDevServer } from "vite";
+
+/**
+ * Exandria+ (local dev only): save/load .map files straight into the project's maps/azgaar/saves folder.
+ * POST /Fantasy-Map-Generator/__exandria/map?name=<name> with the .map text writes saves/<name>.map; GET returns it (usable as ?maplink=)
+ */
+const exandriaSaves = {
+  name: "exandria-saves",
+  configureServer(server: ViteDevServer) {
+    const dir = fileURLToPath(new URL("../saves/", import.meta.url));
+    const exportDir = fileURLToPath(new URL("../exports/", import.meta.url));
+    // POST /Fantasy-Map-Generator/__exandria/export?name=<name> with PNG bytes writes exports/<name>.png
+    server.middlewares.use("/Fantasy-Map-Generator/__exandria/export", ((req, res) => {
+      const name = new URL(req.url || "", "http://x").searchParams.get("name") || "";
+      if (req.method !== "POST" || !/^[a-z0-9-]+$/.test(name)) {
+        res.statusCode = 400;
+        return res.end("bad request");
+      }
+      const chunks: Buffer[] = [];
+      req.on("data", (chunk: Buffer) => chunks.push(chunk));
+      req.on("end", () => {
+        mkdirSync(exportDir, { recursive: true });
+        writeFileSync(`${exportDir}${name}.png`, Buffer.concat(chunks));
+        res.end(`exported ${name}.png`);
+      });
+    }) as Connect.NextHandleFunction);
+    server.middlewares.use("/Fantasy-Map-Generator/__exandria/map", ((req, res) => {
+      const name = new URL(req.url || "", "http://x").searchParams.get("name") || "";
+      if (!/^[a-z0-9-]+$/.test(name)) {
+        res.statusCode = 400;
+        return res.end("bad name");
+      }
+      const file = `${dir}${name}.map`;
+      if (req.method === "POST") {
+        const chunks: Buffer[] = [];
+        req.on("data", (chunk: Buffer) => chunks.push(chunk));
+        req.on("end", () => {
+          mkdirSync(dir, { recursive: true });
+          writeFileSync(file, Buffer.concat(chunks));
+          res.end(`saved ${name}.map`);
+        });
+        return;
+      }
+      if (!existsSync(file)) {
+        res.statusCode = 404;
+        return res.end("not found");
+      }
+      res.setHeader("Content-Type", "text/plain; charset=utf-8");
+      res.end(readFileSync(file));
+    }) as Connect.NextHandleFunction);
+  }
+};
 
