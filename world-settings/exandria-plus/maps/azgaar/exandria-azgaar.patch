+/** id of an ice-free (noIce) precreated biome at or within 2 px of a map point, else 0; sampled wider than the
+ * drawn strip so the biome band and the gap cut into the ice polygons are the same cells */
+export function noIceBiomeAt(x: number, y: number): number {
+  const map = window.precreatedBiomeMap;
+  if (!map) return 0;
+  const noIce = map.custom.filter(b => b.noIce).map(b => b.id);
+  if (!noIce.length) return 0;
+  for (const [dx, dy] of [[0, 0], [2, 0], [-2, 0], [0, 2], [0, -2]]) {
+    const px = Math.min(map.width - 1, Math.max(0, Math.floor(((x + dx) / options.map.graph.width) * map.width)));
+    const py = Math.min(map.height - 1, Math.max(0, Math.floor(((y + dy) / options.map.graph.height) * map.height)));
+    const id = map.data[(py * map.width + px) * 4];
+    if (noIce.includes(id)) return id;
+  }
+  return 0;
